# Royal Properties — Environment Variables
# Copy this file to .env and fill in your values.
# In Replit, set these in Secrets (Tools → Secrets).

# ── Supabase ──────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Notes ─────────────────────────────────────────────────
# The ANON key is safe to expose in the browser.
# Row Level Security (RLS) on Supabase controls what unauthenticated
# users can read/write — never disable RLS.
# The admin email/password is set directly in Supabase Auth,
# not here. See README.md for the admin setup steps.
